---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-slate-200 bg-white/80 px-4 py-2 text-sm text-slate-700 shadow-sm backdrop-blur-md"
>
  {
    user ? (
      <>
        <span class="text-slate-500">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-emerald-600 transition-colors hover:text-emerald-800 hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-emerald-600 transition-colors hover:text-emerald-800 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-slate-500">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-emerald-600 transition-colors hover:text-emerald-800 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-emerald-600 transition-colors hover:text-emerald-800 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
