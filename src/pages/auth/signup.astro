---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="flex min-h-screen items-center justify-center bg-slate-50 p-4 text-slate-900">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="mb-6 text-center text-2xl font-bold text-slate-900">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-slate-600">
        Already have an account? <a href="/auth/signin" class="text-emerald-600 hover:underline">Sign in</a>
      </p>
    </div>
  </div>
</Layout>
