---
import Layout from "@/layouts/Layout.astro";
import AccountsManager from "@/components/AccountsManager";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen text-white">
    <div class="container mx-auto p-4 max-w-5xl pt-8">
      <div class="flex justify-between items-center mb-8 pb-4 border-b border-white/10">
        <div>
          <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-transparent">
            Dashboard
          </h1>
          <p class="text-blue-100/80 mt-1 text-sm">
            Welcome, <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
      
      <div class="bg-white text-black rounded-2xl shadow-xl overflow-hidden">
        <AccountsManager client:load />
      </div>
    </div>
  </div>
</Layout>
