---
import Layout from "@/layouts/Layout.astro";
import AccountsManager from "@/components/AccountsManager";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen text-white">
    <div class="container mx-auto max-w-5xl p-4 pt-8">
      <div class="mb-8 flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Dashboard
          </h1>
          <p class="mt-1 text-sm text-blue-100/80">
            Welcome, <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>

      <div class="overflow-hidden rounded-2xl bg-white text-black shadow-xl">
        <AccountsManager client:load />
      </div>
    </div>
  </div>
</Layout>
