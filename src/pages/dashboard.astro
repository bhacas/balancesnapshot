---
import Layout from "@/layouts/Layout.astro";
import AccountsManager from "@/components/AccountsManager";
import SnapshotManager from "@/components/SnapshotManager";

import NetWorthDashboard from "@/components/NetWorthDashboard";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <div class="container mx-auto max-w-5xl p-4 pt-8">
      <div class="mb-8 flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
          <h1 class="text-3xl font-bold text-slate-900">Dashboard</h1>
          <p class="mt-1 text-sm text-slate-500">
            Welcome, <span class="font-semibold text-slate-700">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm text-slate-700 shadow-sm transition-colors hover:bg-slate-100"
          >
            Sign out
          </button>
        </form>
      </div>

      <div class="space-y-8">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <NetWorthDashboard client:load />
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <AccountsManager client:load />
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <SnapshotManager client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
