{
  "eslint-auto-fix": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix . --quiet",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
